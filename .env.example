# Copy to .env.local and fill in. Every variable is validated at start-up
# (src/server/config/env.ts); a missing or malformed value stops the server
# with a message naming it.

# --- App -------------------------------------------------------------------
# Public base URL, used in links sent by email.
APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# PostgreSQL connection string. Required in production.
# Leave unset in development to use the embedded PGlite database, stored in
# PGLITE_DATA_DIR — nothing to install.
# DATABASE_URL=postgres://cheeta:password@localhost:5432/cheeta_aosa
DATABASE_POOL_MAX=10
# Set to true for managed Postgres that requires TLS.
DATABASE_SSL=false
PGLITE_DATA_DIR=.data/pglite
# Apply pending migrations when the server starts. Defaults to true outside
# production; in production run `npm run db:migrate` as a deploy step.
# AUTO_MIGRATE=true
# Load demo institutions, demo accounts and sample applications into an
# empty database. Defaults to true outside production.
# SEED_DEMO_DATA=true

# --- Auth ------------------------------------------------------------------
# Signs session, password-reset and file-download tokens. Required in
# production: at least 32 random characters, e.g. `openssl rand -base64 48`.
# Changing it signs everyone out.
SESSION_SECRET=

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error   (default: debug in development, info in production)
# LOG_LEVEL=info
# json | pretty                 (default: pretty in development, json in production)
# LOG_FORMAT=json

# --- File storage ----------------------------------------------------------
# Only "local" exists today: files on disk under STORAGE_LOCAL_DIR. Use a
# persistent volume in production. Object storage (S3 and similar) is added
# as another driver in src/server/storage/driver.ts.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
STORAGE_MAX_UPLOAD_MB=10
STORAGE_DOWNLOAD_TTL_SECONDS=300

# --- Messaging -------------------------------------------------------------
# Only "console" exists today (messages are logged, not sent). A real email
# or SMS provider goes in src/lib/notifications.
EMAIL_PROVIDER=console
SMS_PROVIDER=console
