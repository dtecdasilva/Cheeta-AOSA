# Cheeta AOSA — environment settings. Copy to .env.local (development) or set them in your host's dashboard (production).
# Every value is checked at start-up (src/server/config/env.ts); a missing or malformed one stops the server with a clear message.

# --- Required in production -------------------------------------------------
NODE_ENV=production
# Public address of the platform, used in emailed links.
APP_URL=https://apply.cheeta-aosa.com
# PostgreSQL connection string. (Leave unset in development to use the embedded database in PGLITE_DATA_DIR.)
DATABASE_URL=postgres://user:password@host:5432/cheeta_aosa
# At least 32 random characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
SESSION_SECRET=

# --- First administrator ------------------------------------------------------
# While the database has no active Cheeta administrator, start-up invites this address as one and sends it a sign-in code.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Cheeta administrator

# --- Database -----------------------------------------------------------------
DATABASE_POOL_MAX=10
# true when the database requires TLS (most managed PostgreSQL services).
DATABASE_SSL=false
# Apply pending migrations at start-up (default true). Instances starting together take turns on a database lock.
AUTO_MIGRATE=true
# Sample institutions, demo accounts with known passwords and generated applicants. Never true in production.
SEED_DEMO_DATA=false
PGLITE_DATA_DIR=.data/pglite

# --- Uploaded files -----------------------------------------------------------
# "database" keeps files in PostgreSQL (works with several instances and on hosts without a lasting disk);
# "local" keeps them in STORAGE_LOCAL_DIR on this server's disk (one instance, with a disk that is kept and backed up).
STORAGE_DRIVER=database
STORAGE_LOCAL_DIR=.data/uploads
STORAGE_MAX_UPLOAD_MB=10

# --- Email and SMS ------------------------------------------------------------
# "console" only writes messages to the log: nobody receives sign-in codes. Choose a real provider in production.
EMAIL_PROVIDER=resend
EMAIL_FROM=admissions@cheeta-aosa.com
RESEND_API_KEY=
# Or EMAIL_PROVIDER=webhook: each message is POSTed as JSON to this URL with the token as a Bearer header.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
SMS_PROVIDER=console
# SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# SMS_PROVIDER=webhook (fits most local SMS aggregators)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# A scheduler calls GET /api/cron/notifications every few minutes with "Authorization: Bearer <CRON_SECRET>"
# to send what is waiting and retry failures.
CRON_SECRET=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
